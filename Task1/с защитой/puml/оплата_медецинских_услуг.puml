@startuml
!theme plain
title Оплата медицинских услуг (с защитой)

entity "Пациент" as patient
actor "Кассир" as cashier
node "Защищенная ККМ" as kkm
node "1С Бухгалтерия\nс шифрованием" as accounting

patient -> cashier : Оплачивает услуги
cashier -> kkm : Вносит данные о платеже\n<b>Защита:</b> Авторизация кассира
kkm -> accounting : Передает информацию\n<b>Защита:</b> Защищенный канал TLS

note right of kkm
  <b>Теги данных:</b> FIN, PII, L2
  <b>Защита:</b>
  - Авторизация по смарт-карте
  - Шифрование данных
  - Защищенное соединение
end note

note right of accounting
  <b>Теги данных:</b> FIN, PII, L3
  <b>Защита:</b>
  - Шифрование базы данных
  - Строгий контроль доступа
  - Детальный аудит операций
  - Токенизация платежных данных
end note
@enduml